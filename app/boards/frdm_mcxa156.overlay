/ {
	our_driver0: our_driver {
		compatible = "our,driver";
		gpios = <&gpio3 0x0 GPIO_ACTIVE_LOW>;
		status = "okay";
	};

	leds {
		compatible = "gpio-leds";

		red_led: led_0 {
			gpios = <&gpio3 0xc GPIO_ACTIVE_LOW>;
		};

		green_led: led_1 {
			gpios = <&gpio3 0xd GPIO_ACTIVE_LOW>;
		};

		blue_led: led_2 {
			gpios = <&gpio3 0x0 GPIO_ACTIVE_LOW>;
		};
	};


};
